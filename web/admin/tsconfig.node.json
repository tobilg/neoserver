{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "orval.config.ts",
    "playwright.config.ts",
    "playwright.ui.config.ts",
    "browser-tests/**/*.ts"
  ]
}
