{
  "name": "neoserver-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-swagger-assets.mjs",
    "codegen": "orval && node scripts/generate-form-schemas.mjs",
    "check:form-schemas": "node scripts/generate-form-schemas.mjs --check",
    "lint": "node --import ./scripts/eslint-typescript-bridge.mjs ./node_modules/eslint/bin/eslint.js .",
    "format:check": "prettier --check .",
    "check:ui-provenance": "node scripts/check-ui-provenance.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:browser": "playwright test --config playwright.ui.config.ts",
    "analyze": "npm run build && node scripts/analyze-bundle.mjs",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "test:build-tools": "node --test scripts/*.test.mjs",
    "prepare": "npm run codegen"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.28.0",
    "maplibre-gl": "^6.1.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-router": "^8.3.0",
    "sonner": "^2.0.7",
    "swagger-ui-dist": "^5.32.12",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "ajv": "^8.20.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.0.0",
    "jsdom": "^28.0.0",
    "msw": "^2.15.0",
    "ol": "10.10.0",
    "orval": "^8.23.0",
    "prettier": "^3.9.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "typescript-eslint-ts": "npm:typescript@^6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
